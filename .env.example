# ---- API / worker (apps/api, apps/worker). Never commit real secrets (SEC-2).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://hf_api:hf_api@localhost:5432/healthflow
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/healthflow
DATABASE_APP_USER=hf_api
DATABASE_APP_PASSWORD=hf_api
REDIS_URL=redis://localhost:6379
# 32 random bytes, base64: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
PUBLIC_SITE_URL=http://localhost:3000
CONSOLE_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DEFAULT_ORG_SLUG=demo
# Staff auth: Keycloak realm issuer, e.g. http://localhost:8080/realms/healthflow
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=healthflow-api
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
STAFF_REQUIRE_MFA=true
# Development only - refused when NODE_ENV=production
AUTH_DEV_SECRET=dev-only-staff-token-secret-change-me
OTP_DEV_ECHO=true
PATIENT_JWT_SECRET=dev-only-patient-jwt-secret-change-me-0123456789
OTP_PEPPER=dev-otp-pepper
DISPLAY_TOKEN_SECRET=dev-display-token-secret
SHARE_LINK_SECRET=dev-share-link-secret
# HealthPay (fake | http)
HEALTHPAY_MODE=fake
HEALTHPAY_BASE_URL=https://sandbox.healthpay.example/api
HEALTHPAY_WEBHOOK_SECRET=dev-healthpay-webhook-secret
# Cequens SMS/WhatsApp (fake | http)
CEQUENS_MODE=fake
CEQUENS_BASE_URL=https://apis.cequens.com
CEQUENS_API_KEY=
CEQUENS_SENDER_AR=HealthFlow
CEQUENS_SENDER_EN=HealthFlow
CEQUENS_WEBHOOK_SECRET=dev-cequens-webhook-secret
FCM_SERVICE_ACCOUNT_JSON=
SMTP_URL=
MAIL_FROM=HealthFlow Clinics <no-reply@healthflow.example>
# Storage (memory | s3) and antivirus (clamd | disabled)
STORAGE_MODE=memory
S3_ENDPOINT=http://localhost:9000
S3_REGION=fra1
S3_BUCKET=healthflow-private
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
AV_MODE=disabled
CLAMD_HOST=localhost
CLAMD_PORT=3310
CHROMIUM_PATH=
