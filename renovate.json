{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 6am on sunday"
  ],
  "timezone": "Africa/Cairo",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "non-major dependencies",
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": [
        "expo",
        "react-native"
      ],
      "matchPackagePrefixes": [
        "expo-"
      ],
      "groupName": "expo sdk",
      "enabled": false,
      "minimumReleaseAge": "7 days"
    }
  ],
  "minimumReleaseAge": "7 days"
}
