# Copy to .env (or set in eas.json profiles). EXPO_PUBLIC_* values are embedded in the JS bundle:
# never put secrets here.

# API base URL including scheme, without /v1. HTTPS only outside local development.
EXPO_PUBLIC_API_URL=https://api.healthflow.eg
# Organisation slug sent as the x-org header on public calls.
EXPO_PUBLIC_ORG_SLUG=demo

# Staff sign-in through Keycloak (OIDC authorization code + PKCE). Leave empty to hide the button.
EXPO_PUBLIC_KEYCLOAK_ISSUER=https://auth.healthflow.eg/realms/healthflow
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=healthflow-mobile
# "1" shows the paste-a-staff-bearer-token form (development builds only).
EXPO_PUBLIC_ALLOW_DEV_STAFF_TOKEN=1

# ---- Build-time only (read by app.config.ts / config plugins, NOT embedded in the bundle)
# Comma-separated universal/app link hosts.
APP_LINK_DOMAINS=healthflow.eg,www.healthflow.eg
# Apple Team ID for associated domains (AASA appID = <TEAM_ID>.eg.healthflow.clinics).
APPLE_TEAM_ID=
# Certificate pinning: host and base64 SHA-256 SPKI pins (primary + backup), comma separated.
CERT_PIN_HOST=api.healthflow.eg
CERT_PINS=
CERT_PIN_EXPIRES=2027-12-31
# "1" adds FLAG_SECURE to the Android activity (blocks screenshots and recents thumbnails).
HF_FLAG_SECURE=1
