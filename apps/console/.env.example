# HealthFlow staff console (apps/console)
# Base URL of the NestJS API (server-side only; the browser talks to the BFF under /api).
API_URL=http://localhost:4000
# Organisation slug used for dev staff tokens (x-org header).
ORG_SLUG=demo
# dev: pick a seeded user on /login (non-production API only). oidc: Keycloak authorization code + PKCE.
AUTH_MODE=dev
# Keycloak realm issuer, e.g. https://sso.example.eg/realms/healthflow
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=healthflow-console
KEYCLOAK_CLIENT_SECRET=
# Public URL of this console (OIDC redirect URI = CONSOLE_URL/api/auth/callback).
CONSOLE_URL=http://localhost:3001
# 32+ random bytes; encrypts the session cookies with AES-256-GCM.
SESSION_SECRET=change-me-to-a-long-random-string
