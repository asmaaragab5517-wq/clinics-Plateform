{
  "name": "@hf/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "node dist/openapi-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@hf/db": "workspace:*",
    "@hf/documents": "workspace:*",
    "@hf/shared": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "bullmq": "^5.52.0",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "jose": "^6.0.0",
    "jszip": "^3.10.2",
    "nodemailer": "^7.0.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.0",
    "@swc/core": "^1.11.0",
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.0"
  },
  "exports": {
    ".": "./dist/main.js",
    "./dist/core": "./dist/core.js"
  }
}