# Base URL of the HealthFlow API (server-side only; never exposed to the browser)
API_URL=http://localhost:4000
# Organisation slug sent as x-org on public API calls
ORG_SLUG=demo
# Public origin of this site (canonical URLs, sitemap, hreflang, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to 1 only for local `next start` over plain http (disables the Secure cookie flag)
# COOKIE_INSECURE=1
